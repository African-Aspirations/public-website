# Database (optional — defaults to local SQLite at .data/local.db)
TURSO_URL=
TURSO_TOKEN=

# Default admin credentials (used when seeding the first admin user)
DEFAULT_ADMIN_EMAIL=admin@africanaspirations.com
DEFAULT_ADMIN_PASSWORD=password123
DEFAULT_ADMIN_NAME=Admin

# Secret used to sign admin session cookies. Required in production — the
# app falls back to an insecure development-only value if unset, which
# would let anyone forge a valid admin session.
AUTH_SECRET=
