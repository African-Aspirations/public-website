# apps/admin — the private admin (Next.js).
# Local dev: copy this file to apps/admin/.env.local and fill it in.
# Vercel: set the same variables in the ADMIN project → Settings → Environment Variables.
# Only NEXT_PUBLIC_* variables reach the browser. Everything else stays on the server.

# The admin's own URL (no trailing slash). Locally http://localhost:3001.
ADMIN_URL=http://localhost:3001
# The public site (links like "View listing"). Locally http://localhost:4321.
SITE_URL=https://www.africanaspirations.com

# ---------- Firebase web app (public: these identify the project, they are not secrets) ----------
# Firebase console → Project settings → General → Your apps → Web app → SDK setup and configuration.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=<project-id>.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=<project-id>
NEXT_PUBLIC_FIREBASE_APP_ID=

# ---------- Firebase Admin SDK (SECRET: server only) ----------
# Firebase console → Project settings → Service accounts → Generate new private key.
# From the downloaded JSON copy "client_email" and "private_key".
# Paste private_key exactly as it is in the JSON, in double quotes, with the \n sequences.
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@<project-id>.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# ---------- Database (SECRET) ----------
# Supabase "Transaction pooler" (port 6543) as the admin_app role.
# Its password is the one you set with: ALTER ROLE admin_app WITH LOGIN PASSWORD '...';
DATABASE_URL_ADMIN=postgresql://admin_app.<project-ref>:<admin_app-password>@aws-0-<region>.pooler.supabase.com:6543/postgres

# ---------- Cloudinary: media library uploads ----------
# Cloudinary console → Settings → API Keys. The secret signs uploads/deletes on the server
# only; the browser uploads straight to Cloudinary with a one-time signature.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ---------- Publish button (SECRET) ----------
# The PUBLIC site's Vercel project → Settings → Git → Deploy Hooks → create one for the
# production branch. Calling this URL rebuilds the site from the database.
VERCEL_DEPLOY_HOOK_URL=

# ---------- Staff emails: invites and password resets (SECRET) ----------
# Same Resend account as the public site. Without a key, the admin shows the link to copy
# and the email is only logged.
RESEND_API_KEY=
RESEND_FROM=African Aspirations <admin@mail.africanaspirations.com>

# ---------- Authenticator app for super admins ----------
# Set to true only after TOTP is enabled in Firebase (Identity Platform). Super admins then
# have to set up an authenticator app and use it at every sign-in.
ADMIN_REQUIRE_MFA=false
