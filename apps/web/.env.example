# Public site (Astro). Server-only unless prefixed PUBLIC_.
PUBLIC_SITE_URL=https://www.africanaspirations.com

# Supabase Postgres via pooler (transaction mode). User format: <role>.<project-ref>
DATABASE_URL_WEB_BUILD=   # web_build role: build-time reads of published content
DATABASE_URL_WEB_FORMS=   # web_forms role: form endpoints (insert-only)

PUBLIC_CLOUDINARY_CLOUD_NAME=

RESEND_API_KEY=
RESEND_FROM=              # e.g. "African Aspirations <hello@mail.yourdomain>"
RESEND_AUDIENCE_ID=
LEADS_NOTIFY_TO=          # team inbox for contact + inquiry notifications

PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
RATE_LIMIT_SALT=          # random string used to hash client IPs
