# apps/web/.env — the public Astro site. Copy to apps/web/.env for local dev.
# On Vercel, set the same variables in Project → Settings → Environment Variables.
# Only variables starting with PUBLIC_ can ever reach the browser.

PUBLIC_SITE_URL=https://www.africanaspirations.com

# Supabase Postgres, "Session pooler" (port 5432; NOT the 6543 transaction pooler, which
# hangs on parallel queries). The user is <role>.<project-ref>.
# Role passwords are the ones you set with ALTER ROLE after running the migrations.
DATABASE_URL_WEB_BUILD=postgresql://web_build.<project-ref>:<web_build-password>@aws-0-<region>.pooler.supabase.com:5432/postgres
DATABASE_URL_WEB_FORMS=postgresql://web_forms.<project-ref>:<web_forms-password>@aws-0-<region>.pooler.supabase.com:5432/postgres

# Cloudinary cloud name only (public: it appears in every image URL). No secret here.
PUBLIC_CLOUDINARY_CLOUD_NAME=

# Resend (phase 4: forms + newsletter)
# Resend → API Keys (sending access). Leave empty locally: emails are then logged, not sent.
RESEND_API_KEY=
RESEND_FROM=African Aspirations <hello@mail.africanaspirations.com>
# Resend → Audience → Segments: create a "Newsletter" segment and copy its id.
RESEND_SEGMENT_ID=
LEADS_NOTIFY_TO=connect@africanaspirations.com

# Cloudflare Turnstile (phase 4: spam protection on forms)
PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Any long random string; used to hash visitor IPs for rate limiting.
RATE_LIMIT_SALT=
