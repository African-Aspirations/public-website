---
import Base from "../layouts/Base.astro";
---
<Base title="Page not found" noindex>
  <section class="layout section">
    <div>
      <p class="eyebrow">404</p>
      <h1>We couldn't find that page</h1>
      <p class="lead">It may have moved, or the link may be out of date.</p>
      <p><a class="btn" href="/">Go to the homepage</a> &nbsp; <a href="/contact">Contact us</a></p>
    </div>
  </section>
</Base>
