---
import { marked } from "marked";
import Img from "../../components/Img.astro";
import Turnstile from "../../components/Turnstile.astro";
import Alert from "../../components/ui/Alert.astro";
import Badge from "../../components/ui/Badge.astro";
import Button from "../../components/ui/Button.astro";
import Card from "../../components/ui/Card.astro";
import Field from "../../components/ui/Field.astro";
import Input from "../../components/ui/Input.astro";
import Section from "../../components/ui/Section.astro";
import Textarea from "../../components/ui/Textarea.astro";
import Base from "../../layouts/Base.astro";
import { cloudinaryEnabled, responsive } from "../../lib/cloudinary";
import { getContent } from "../../lib/content";
import { formatMoney } from "../../lib/format";
import { breadcrumbLd } from "../../lib/seo";

export async function getStaticPaths() {
  const c = await getContent();
  return c.listings.map((l) => ({ params: { slug: l.slug }, props: { id: l.id } }));
}

const c = await getContent();
const l = c.listings.find((x) => x.id === Astro.props.id);
if (!l) throw new Error(`listing ${Astro.props.id} not found`);
const price = formatMoney(l.price, l.currency);
const details = [
  ["Sector", l.category?.label],
  ["Location", l.location],
  ["Asking price", price ?? "Price on request"],
  ["Down payment", formatMoney(l.downPayment, l.currency)],
  ["SDE (seller's discretionary earnings)", formatMoney(l.sde, l.currency)],
].filter((d): d is [string, string] => Boolean(d[1]));
const description = await marked.parse(l.description);
const SIZES = "(min-width: 64rem) 680px, 100vw";
const site = new URL("/", Astro.site).toString();
const jsonLd = [
  breadcrumbLd(c, `listings/${l.slug}`, l.name),
  {
    "@context": "https://schema.org",
    "@type": "Product",
    name: l.name,
    description: l.summary ?? l.description.slice(0, 300),
    category: l.category?.label,
    ...(l.cover && cloudinaryEnabled && { image: responsive(l.cover, 4 / 3).src }),
    offers: {
      "@type": "Offer",
      url: new URL(`/listings/${l.slug}`, site).toString(),
      availability: "https://schema.org/InStock",
      ...(l.price && { price: Number(l.price), priceCurrency: l.currency }),
      seller: { "@type": "Organization", name: c.settings.orgName },
    },
  },
];
---
<Base
  title={l.name}
  description={l.summary ?? l.description.slice(0, 155)}
  ogImage={l.cover}
  preload={l.cover && cloudinaryEnabled ? { srcset: responsive(l.cover, 4 / 3).srcset, sizes: SIZES } : null}
  jsonLd={jsonLd}
>
  <Section>
    <div class="grid gap-gutter lg:grid-cols-[2fr_1fr]">
      <article>
        <nav class="mb-4 text-sm text-muted-foreground" aria-label="Breadcrumb"><a href="/listings" class="text-primary">Listings</a> › <span aria-current="page">{l.name}</span></nav>
        {l.category && <Badge variant="secondary" class="mb-3">{l.category.label}</Badge>}
        <h1 class="text-display">{l.name}</h1>
        {l.location && <p class="mt-2 text-lg text-muted-foreground">{l.location}</p>}
        <Img media={l.cover} sizes={SIZES} aspect={4 / 3} priority class="my-8 w-full rounded-media" />
        <h2 class="mb-4 text-2xl">About this business</h2>
        <div class="prose" set:html={description} />
        {l.images.length > 0 && (
          <ul class="mt-8 grid grid-cols-2 gap-4">{l.images.map((m) => <li><Img media={m} sizes="(min-width: 64rem) 330px, 50vw" aspect={4 / 3} class="w-full rounded-media" /></li>)}</ul>
        )}
      </article>
      <aside>
        <Card class="sticky top-24 gap-4 px-6">
          <p class="text-2xl font-semibold">{price ?? "Price on request"}</p>
          <dl class="grid gap-3">{details.map(([k, v]) => <div><dt class="text-sm text-muted-foreground">{k}</dt><dd class="font-semibold">{v}</dd></div>)}</dl>
          <Button href="#inquire" size="lg">Enquire about this business</Button>
        </Card>
      </aside>
    </div>
  </Section>
  <Section id="inquire" tight>
    <div class="max-w-narrow">
      <h2 class="mb-6 text-title">Enquire about {l.name}</h2>
      <Alert id="sent" variant="success" class="mb-6">Thank you — your enquiry has been sent. Our brokerage team will contact you shortly.</Alert>
      <Alert id="error" variant="destructive" class="mb-6">Something went wrong. Please try again, or email us directly.</Alert>
      <form method="post" action="/api/inquiry" class="grid gap-5">
        <input type="hidden" name="listing" value={l.slug} />
        <Field label="Full name"><Input name="name" required autocomplete="name" maxlength={120} /></Field>
        <Field label="Email"><Input name="email" type="email" required autocomplete="email" maxlength={200} /></Field>
        <Field label="Phone" hint="(optional)"><Input name="phone" type="tel" autocomplete="tel" maxlength={40} /></Field>
        <Field label="Message"><Textarea name="message" rows={5} required maxlength={5000}>{`I'm interested in "${l.name}". Please send me more information.`}</Textarea></Field>
        <input class="absolute -left-[9999px]" name="website" tabindex="-1" autocomplete="off" aria-hidden="true" />
        <Turnstile />
        <Button type="submit" size="lg" class="justify-self-start">Send enquiry</Button>
      </form>
    </div>
  </Section>
</Base>
