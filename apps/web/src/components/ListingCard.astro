---
import type { Listing } from "../lib/content";
import { formatMoney } from "../lib/format";
import Img from "./Img.astro";
import Badge from "./ui/Badge.astro";

interface Props {
  listing: Listing;
}
const { listing: l } = Astro.props;
---
<article class="group relative flex flex-col gap-3">
  <Img media={l.cover} sizes="(min-width: 64rem) 360px, (min-width: 40rem) 50vw, 100vw" aspect={4 / 3} alt="" class="w-full rounded-xl" />
  <div class="grid gap-1">
    {l.category && <Badge variant="secondary">{l.category.label}</Badge>}
    <h3 class="text-lg"><a href={`/listings/${l.slug}`} class="text-foreground no-underline after:absolute after:inset-0 group-hover:text-primary">{l.name}</a></h3>
    <p class="text-sm text-muted-foreground">{l.region ?? l.location ?? "Ghana"}</p>
    <p class="font-semibold">{formatMoney(l.price, l.currency) ?? "Price on request"}</p>
  </div>
</article>
