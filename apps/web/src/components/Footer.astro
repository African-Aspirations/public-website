---
import { getContent } from "../lib/content";

const { settings, footerColumns: allColumns } = await getContent();
const footerColumns = allColumns.filter((col) => col.items.length > 0);
const year = new Date().getFullYear();
const tel = settings.phone?.replace(/[^\d+]/g, "");
const link = "text-inherit no-underline hover:underline";
---
<footer class="site-footer layout bg-brand-dark pb-8 pt-12 text-[#e8f0e0]">
  <div class="cols grid grid-cols-1 gap-x-gutter gap-y-8 sm:grid-cols-2 lg:grid-cols-[2fr_repeat(var(--n),1fr)]" style={`--n:${footerColumns.length}`}>
    <div class="sm:col-span-full lg:col-span-1">
      <p class="font-semibold text-white">{settings.orgName}</p>
      {settings.tagline && <p class="mt-2">{settings.tagline}</p>}
      <address class="mt-3 grid gap-1 not-italic">
        {settings.address && <span>{settings.address}</span>}
        {settings.phone && <a class={link} href={`tel:${tel}`}>{settings.phone}</a>}
        {settings.email && <a class={link} href={`mailto:${settings.email}`}>{settings.email}</a>}
      </address>
    </div>
    {footerColumns.map((col) => (
      <nav aria-label={col.heading}>
        <p class="font-semibold text-white">{col.heading}</p>
        <ul class="mt-3 grid gap-2">{col.items.map((i) => <li><a class={link} href={i.href}>{i.label}</a></li>)}</ul>
      </nav>
    ))}
  </div>
  <div class="mt-12 flex flex-wrap justify-between gap-4 border-t border-[#2f5a3a] pt-6 text-sm">
    <p>© {year} {settings.orgName}</p>
    {settings.socials.length > 0 && (
      <ul class="flex gap-6">
        {settings.socials.map((s) => <li><a class={link} href={s.url} rel="noopener" target="_blank">{s.label}</a></li>)}
      </ul>
    )}
  </div>
</footer>
