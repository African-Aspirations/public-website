---
import type { SectionData } from "@aa/db";
import Section from "../ui/Section.astro";
import SectionHeader from "../ui/SectionHeader.astro";

interface Props {
  data: SectionData<"stats">;
}
const { data } = Astro.props;
---
<Section>
  <SectionHeader heading={data.heading} />
  <dl class="grid gap-gutter sm:grid-cols-[repeat(auto-fit,minmax(12rem,1fr))]">
    {data.stats.map((s) => (
      <div class="flex flex-col-reverse border-l-3 border-gold pl-4">
        <dt class="text-muted-foreground">{s.label}</dt>
        <dd class="text-title font-semibold text-primary">{s.value}</dd>
      </div>
    ))}
  </dl>
</Section>
