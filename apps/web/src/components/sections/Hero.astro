---
import type { SectionData } from "@aa/db";
import { getContent } from "../../lib/content";
import { HERO_ASPECT, HERO_SIZES } from "../../lib/hero";
import Img from "../Img.astro";
import Button from "../ui/Button.astro";
import Section from "../ui/Section.astro";

interface Props {
  data: SectionData<"hero">;
}
const { data } = Astro.props;
const c = await getContent();
const images = data.imageIds.map((id) => c.media(id)).filter((m) => m !== null);
---
<Section>
  <div class="grid items-center gap-gutter md:grid-cols-2">
    <div class:list={[!images.length && "md:col-span-2 max-w-3xl"]}>
      {data.eyebrow && <p class="mb-2 text-sm font-semibold uppercase tracking-wider text-brand-leaf">{data.eyebrow}</p>}
      <h1 class="text-display">{data.heading}</h1>
      {data.body && <p class="mt-4 text-lg text-muted-foreground">{data.body}</p>}
      {data.cta && <Button href={data.cta.href} size="lg" class="mt-6">{data.cta.label}</Button>}
    </div>
    {images.length > 0 && (
      images.length === 1 ? (
        <Img media={images[0]!} sizes={HERO_SIZES} aspect={HERO_ASPECT} priority class="w-full rounded-xl" />
      ) : (
        <ul class="flex snap-x snap-mandatory gap-2 overflow-x-auto rounded-xl" aria-label="Photos">
          {images.map((m, i) => <li class="shrink-0 basis-full snap-start"><Img media={m} sizes={HERO_SIZES} aspect={HERO_ASPECT} priority={i === 0} class="w-full" /></li>)}
        </ul>
      )
    )}
  </div>
</Section>
