---
/**
 * Page hero. Text left, photo (or carousel) right; stacked on mobile, text first.
 * Carousel: CSS scroll-snap (swipe works without JS). A tiny inline script adds
 * prev/next arrows, shown on hover with a mouse and always on touch screens.
 * variant "collage": two overlapping photos left, heading + markdown body right
 * (the last paragraph muted). logoBanner: the site logo, large, in a band above.
 * variant "band": white text on a full-width green band, landscape photo right;
 * on nested pages (e.g. /business-consulting/advisory) a breadcrumb above the h1.
 */
import type { SectionData } from "@aa/db";
import { marked } from "marked";
import { getContent } from "../../lib/content";
import {
  BAND_ASPECT,
  BAND_SIZES,
  COLLAGE_ASPECT,
  COLLAGE_SIZES,
  HERO_ASPECT,
  HERO_SIZES,
} from "../../lib/hero";
import Img from "../Img.astro";
import Button from "../ui/Button.astro";
import Section from "../ui/Section.astro";

interface Props {
  data: SectionData<"hero">;
}
const { data } = Astro.props;
const c = await getContent();
const images = data.imageIds.map((id) => c.media(id)).filter((m) => m !== null);
const collage = data.variant === "collage";
const band = data.variant === "band";
// Breadcrumb (band only). Nested URL: every ancestor that is a page, then this page.
// Top-level page inside a header menu group: the group's label (text), then this page.
const path = Astro.url.pathname.replace(/\/$/, "");
const parts = path.split("/").filter(Boolean);
const titleOf = (slug: string) => c.pages.find((p) => p.slug === slug)?.title ?? slug;
const group = c.header.find((g) => g.children.some((ch) => ch.href === path));
const crumbs: { href?: string; title: string }[] = !band
  ? []
  : parts.length > 1
    ? parts.map((_, i) => ({
        href: `/${parts.slice(0, i + 1).join("/")}`,
        title: titleOf(parts.slice(0, i + 1).join("/")),
      }))
    : group && parts[0]
      ? [{ title: group.label }, { title: titleOf(parts[0]) }]
      : [];
const bodyHtml = collage && data.body ? await marked.parse(data.body) : null;
const logo = data.logoBanner ? c.media(c.settings.logoId) : null;
const photo = "aspect-[4/5] w-full object-cover sm:aspect-square";
const arrow =
  "absolute top-1/2 grid size-10 -translate-y-1/2 place-items-center rounded-full bg-black-40 text-white transition-opacity hover:bg-black-60 focus-visible:opacity-100 [@media(hover:hover)]:opacity-0 [@media(hover:hover)]:group-hover:opacity-100";
---
{logo && (
  <div class="layout border-b py-12 md:py-20">
    <Img media={logo} sizes="(min-width: 48rem) 320px, 60vw" priority={!images.length} alt="" class="mx-auto w-3/5 max-w-80" />
  </div>
)}
{band ? (
<Section tone="dark">
  <div class="grid items-center gap-10 md:grid-cols-2 md:gap-gutter">
    <div class:list={[!images.length && "md:col-span-2 max-w-3xl"]}>
      {crumbs.length > 0 && (
        <nav aria-label="Breadcrumb" class="mb-4 text-xs">
          <ol class="flex flex-wrap items-center gap-1.5 text-white-70">
            {crumbs.map((cr, i) => i < crumbs.length - 1 ? (
              <li class="flex items-center gap-1.5">{cr.href ? <a href={cr.href} class="text-inherit no-underline hover:text-white">{cr.title}</a> : cr.title}<span aria-hidden="true">›</span></li>
            ) : (
              <li aria-current="page" class="font-semibold text-white">{cr.title}</li>
            ))}
          </ol>
        </nav>
      )}
      {data.eyebrow && <p class="mb-2 text-sm font-semibold uppercase tracking-wider text-white-70">{data.eyebrow}</p>}
      <h1 class="text-display font-normal text-white">{data.heading}{data.accent && <> <span class="text-brand-mint">{data.accent}</span></>}</h1>
      {data.body && <p class="mt-4 max-w-md text-lg text-white-85">{data.body}</p>}
      {data.cta && <Button href={data.cta.href} class="mt-6 bg-white px-7 font-semibold text-primary hover:bg-secondary">{data.cta.label}</Button>}
    </div>
    {images[0] && (data.imageFrame ? (
      <div class="grid aspect-[17/10] w-full place-items-center rounded-media bg-white-10 p-[6%] md:justify-self-end lg:w-[90%]">
        <Img media={images[0]} sizes={BAND_SIZES} priority class="max-h-full w-full object-contain" />
      </div>
    ) : (
      <Img media={images[0]} sizes={BAND_SIZES} aspect={BAND_ASPECT} priority class="w-full rounded-media object-cover md:justify-self-end lg:w-[90%]" />
    ))}
  </div>
</Section>
) : collage ? (
<Section>
  <div class="grid items-center gap-12 md:grid-cols-2 md:gap-gutter">
    {images.length > 0 && (
      <div class="md:pr-10">
        <Img media={images[0]!} sizes={COLLAGE_SIZES} aspect={COLLAGE_ASPECT} priority class="w-4/5 rounded-[2rem] object-cover" />
        {images[1] && (
          <Img media={images[1]} sizes={COLLAGE_SIZES} aspect={COLLAGE_ASPECT} class="relative -mt-[12%] ml-auto w-4/5 rounded-[2rem] object-cover shadow-popover" />
        )}
      </div>
    )}
    <div class:list={["max-w-xl", !images.length && "md:col-span-2"]}>
      <h1 class="text-xl md:text-2xl">{data.heading}</h1>
      {bodyHtml && <div class="prose mt-6 text-lg [&>p:last-child]:text-muted-foreground" set:html={bodyHtml} />}
      {data.cta && <Button href={data.cta.href} variant="outline" class="mt-8 font-semibold">{data.cta.label}</Button>}
    </div>
  </div>
</Section>
) : (
<Section>
  <div class="grid items-start gap-10 md:grid-cols-2 md:gap-gutter">
    <div class:list={["md:pt-2", !images.length && "md:col-span-2 max-w-3xl"]}>
      {data.eyebrow && <p class="mb-2 text-sm font-semibold uppercase tracking-wider text-brand-leaf">{data.eyebrow}</p>}
      <h1 class="text-display">
        {data.heading}
        {data.accent && <span class="block text-brand-leaf">{data.accent}</span>}
      </h1>
      {data.body && <p class="mt-6 max-w-xl text-lg">{data.body}</p>}
      {data.cta && <Button href={data.cta.href} variant="outline" class="mt-8 font-semibold">{data.cta.label}</Button>}
    </div>
    {images.length === 1 && <Img media={images[0]!} sizes={HERO_SIZES} aspect={HERO_ASPECT} priority class={`${photo} rounded-media`} />}
    {images.length > 1 && (
      <div class="hero-carousel group relative">
        <ul class="flex snap-x snap-mandatory overflow-x-auto rounded-media [scrollbar-width:none] [&::-webkit-scrollbar]:hidden" aria-label="Photos">
          {images.map((m, i) => (
            <li class="w-full shrink-0 snap-start" aria-label={`${i + 1} of ${images.length}`}>
              <Img media={m} sizes={HERO_SIZES} aspect={HERO_ASPECT} priority={i === 0} class={photo} />
            </li>
          ))}
        </ul>
        <button type="button" data-dir="-1" class={`${arrow} left-3`} aria-label="Previous photo" hidden>
          <svg class="size-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M19 12H5m7 7-7-7 7-7" /></svg>
        </button>
        <button type="button" data-dir="1" class={`${arrow} right-3`} aria-label="Next photo" hidden>
          <svg class="size-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14m-7-7 7 7-7 7" /></svg>
        </button>
      </div>
    )}
  </div>
</Section>
)}
{!collage && !band && images.length > 1 && (
  <script is:inline>
    for (const root of document.querySelectorAll(".hero-carousel:not([data-ready])")) {
      root.dataset.ready = "";
      const track = root.querySelector("ul");
      const smooth = matchMedia("(prefers-reduced-motion: no-preference)").matches ? "smooth" : "auto";
      for (const btn of root.querySelectorAll("button")) {
        btn.hidden = false;
        btn.addEventListener("click", () => {
          const w = track.clientWidth;
          const i = Math.round(track.scrollLeft / w) + Number(btn.dataset.dir);
          const n = track.children.length;
          track.scrollTo({ left: ((i + n) % n) * w, behavior: smooth });
        });
      }
    }
  </script>
)}
