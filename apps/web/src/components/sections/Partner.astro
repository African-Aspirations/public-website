---
/**
 * Global partner. Large heading + the description's first paragraph left, logo and
 * stats right; the rest of the description runs underneath.
 * "boxed": logo, heading, one line of text and big stats, centred in a bordered box.
 * `body` overrides the description.
 */
import type { SectionData } from "@aa/db";
import { marked } from "marked";
import { getContent } from "../../lib/content";
import Img from "../Img.astro";
import Section from "../ui/Section.astro";

interface Props {
  data: SectionData<"partner">;
}
const { data } = Astro.props;
const c = await getContent();
const p = c.partner(data.partnerId);
const logo = p ? c.media(p.logoId) : null;
const [intro, ...rest] = (data.body ?? p?.description ?? "").split(/\n\s*\n/);
const restHtml = rest.length ? await marked.parse(rest.join("\n\n")) : null;
const heading = data.heading ?? p?.name;
---
{p && data.variant === "boxed" && (
  <Section id="our-global-partner">
    <div class="rounded-[1.5rem] border border-brand-line px-5 py-10 text-center sm:px-10 md:py-14">
      {logo && <Img media={logo} sizes="160px" class="mx-auto w-36" />}
      <h2 class="mx-auto mt-6 max-w-xl text-2xl md:text-3xl">{heading}</h2>
      {intro && <p class="mx-auto mt-4 max-w-xl text-sm text-muted-foreground">{intro}</p>}
      {p.stats.length > 0 && (
        <dl class="mx-auto mt-10 grid max-w-4xl grid-cols-3 gap-2 sm:gap-6">
          {p.stats.map((s) => (
            <div class="flex flex-col-reverse justify-end gap-1">
              <dt class="text-[0.625rem] uppercase tracking-wider sm:tracking-[0.15em] text-muted-foreground sm:text-xs">{s.label}</dt>
              <dd class="text-xl font-semibold text-primary sm:text-4xl md:text-5xl">{s.value}</dd>
            </div>
          ))}
        </dl>
      )}
    </div>
  </Section>
)}
{p && data.variant !== "boxed" && (
  <Section id="our-global-partner">
    <div class="grid gap-10 md:grid-cols-2 md:gap-gutter">
      <div>
        <h2 class="text-display">{heading}</h2>
        {intro && <p class="mt-8 max-w-md text-lg text-muted-foreground md:mt-16">{intro}</p>}
      </div>
      <div class="grid content-start justify-items-center gap-8">
        {logo && (
          p.url ? (
            <a href={p.url} rel="noopener" class="block w-3/5 max-w-72"><Img media={logo} sizes="288px" alt={`${p.name} website`} /></a>
          ) : (
            <Img media={logo} sizes="288px" class="w-3/5 max-w-72" />
          )
        )}
        {p.stats.length > 0 && (
          <dl class="grid w-full grid-cols-3 gap-2 border-t pt-8 text-center sm:gap-4">
            {p.stats.map((s) => (
              <div class="flex flex-col-reverse gap-1">
                <dt class="text-xs text-muted-foreground sm:text-sm">{s.label}</dt>
                <dd class="text-xl font-semibold text-primary sm:text-2xl">{s.value}</dd>
              </div>
            ))}
          </dl>
        )}
      </div>
    </div>
    {restHtml && <div class="prose mt-12 max-w-3xl text-muted-foreground" set:html={restHtml} />}
  </Section>
)}
