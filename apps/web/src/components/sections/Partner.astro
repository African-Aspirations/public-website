---
import type { SectionData } from "@aa/db";
import { getContent } from "../../lib/content";
import Img from "../Img.astro";
import Section from "../ui/Section.astro";

interface Props {
  data: SectionData<"partner">;
}
const c = await getContent();
const p = c.partner(Astro.props.data.partnerId);
const logo = p ? c.media(p.logoId) : null;
---
{p && (
  <Section tone="band" id="our-global-partner">
    <div class="grid items-center gap-gutter lg:grid-cols-[7fr_5fr]">
      <div>
        <p class="mb-2 text-sm font-semibold uppercase tracking-wider text-brand-leaf">Global partner</p>
        <h2 class="text-title">{p.url ? <a href={p.url} rel="noopener" class="text-inherit">{p.name}</a> : p.name}</h2>
        {p.description && <p class="mt-4">{p.description}</p>}
      </div>
      <div class="grid gap-6">
        {logo && <Img media={logo} sizes="200px" class="w-50" />}
        {p.stats.length > 0 && (
          <dl class="grid grid-cols-[repeat(auto-fit,minmax(8rem,1fr))] gap-4">
            {p.stats.map((s) => <div class="flex flex-col-reverse"><dt class="text-sm text-muted-foreground">{s.label}</dt><dd class="text-xl font-semibold text-primary">{s.value}</dd></div>)}
          </dl>
        )}
      </div>
    </div>
  </Section>
)}
