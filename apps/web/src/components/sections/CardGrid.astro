---
import type { SectionData } from "@aa/db";
import { getContent } from "../../lib/content";
import Img from "../Img.astro";
import Section from "../ui/Section.astro";
import SectionHeader from "../ui/SectionHeader.astro";

interface Props {
  data: SectionData<"card_grid">;
}
const { data } = Astro.props;
const c = await getContent();
const cols = { 2: "lg:grid-cols-2", 3: "lg:grid-cols-3", 4: "lg:grid-cols-4" }[data.columns];
const sizes =
  data.columns >= 3
    ? "(min-width: 64rem) 360px, (min-width: 40rem) 50vw, 100vw"
    : "(min-width: 64rem) 560px, 100vw";
---
<Section>
  <SectionHeader eyebrow={data.eyebrow} heading={data.heading} intro={data.intro} />
  <ul class:list={["grid gap-gutter sm:grid-cols-2", cols]}>
    {data.cards.map((card) => {
      const img = c.media(card.imageId);
      return (
        <li class="group relative flex flex-col gap-2">
          {img && <Img media={img} sizes={sizes} aspect={4 / 3} class="mb-2 w-full rounded-xl" />}
          <h3 class="text-lg">
            {card.href ? (
              <a href={card.href} class="text-foreground no-underline after:absolute after:inset-0 group-hover:text-primary">{card.title} <span class="text-primary" aria-hidden="true">→</span></a>
            ) : card.title}
          </h3>
          {card.body?.split("\n\n").map((p) => <p class="text-muted-foreground">{p}</p>)}
          {card.items && card.items.length > 0 && (
            <ul class="mt-2 grid list-disc gap-2 pl-5 text-sm">
              {card.items.map((i) => <li><strong class="font-semibold">{i.title}</strong>{i.body && <> — {i.body}</>}</li>)}
            </ul>
          )}
        </li>
      );
    })}
  </ul>
</Section>
