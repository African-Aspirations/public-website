---
import type { SectionData } from "@aa/db";
import { marked } from "marked";
import { getContent } from "../../lib/content";
import Img from "../Img.astro";
import Accordion from "../ui/Accordion.astro";
import Section from "../ui/Section.astro";
import SectionHeader from "../ui/SectionHeader.astro";

interface Props {
  data: SectionData<"team">;
}
const { data } = Astro.props;
const c = await getContent();
const members = await Promise.all(
  c.team.map(async (m) => ({
    ...m,
    photo: c.media(m.photoId),
    bioHtml: m.bio ? await marked.parse(m.bio) : null,
  })),
);
---
<Section id="our-team">
  <SectionHeader heading={data.heading} intro={data.intro} />
  <ul class="grid gap-gutter sm:grid-cols-2 lg:grid-cols-3">
    {members.map((m) => (
      <li>
        <Img media={m.photo} sizes="(min-width: 64rem) 360px, (min-width: 40rem) 50vw, 100vw" aspect={4 / 5} class="mb-4 w-full rounded-media" />
        <h3 class="text-lg">{m.name}{m.credentials && <span class="text-sm font-normal text-muted-foreground">, {m.credentials}</span>}</h3>
        <p class="font-semibold text-primary">{m.role}</p>
        {m.summary && <p class="mt-2">{m.summary}</p>}
        {m.bioHtml && (
          <Accordion title="Read full bio" class="mt-2 border-b-0">
            <div class="prose text-sm text-foreground" set:html={m.bioHtml} />
          </Accordion>
        )}
      </li>
    ))}
  </ul>
</Section>
