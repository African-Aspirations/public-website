---
import type { SectionData } from "@aa/db";
import { marked } from "marked";
import { getContent } from "../../lib/content";
import Img from "../Img.astro";

interface Props {
  data: SectionData<"team">;
}
const { data } = Astro.props;
const c = await getContent();
const members = await Promise.all(
  c.team.map(async (m) => ({
    ...m,
    photo: c.media(m.photoId),
    bioHtml: m.bio ? await marked.parse(m.bio) : null,
  })),
);
---
<section class="layout section" id="our-team">
  <div>
    <header class="head">
      {data.heading && <h2>{data.heading}</h2>}
      {data.intro && <p class="lead">{data.intro}</p>}
    </header>
    <ul class="team">
      {members.map((m) => (
        <li>
          <Img media={m.photo} sizes="(min-width: 64rem) 360px, (min-width: 40rem) 50vw, 100vw" aspect={4 / 5} />
          <h3>{m.name}{m.credentials && <span class="cred">, {m.credentials}</span>}</h3>
          <p class="role">{m.role}</p>
          {m.summary && <p>{m.summary}</p>}
          {m.bioHtml && (
            <details>
              <summary>Read full bio</summary>
              <div class="prose" set:html={m.bioHtml} />
            </details>
          )}
        </li>
      ))}
    </ul>
  </div>
</section>
<style>
  .head { max-width: var(--content-narrow); margin-bottom: var(--space-8); }
  .team { list-style: none; margin: 0; padding: 0; display: grid; gap: var(--gutter); grid-template-columns: repeat(auto-fill, minmax(min(100%, 16rem), 1fr)); }
  .team :global(img), .team :global(.img-placeholder) { border-radius: var(--radius); margin-bottom: var(--space-4); }
  h3 { margin: 0; }
  .cred { font-weight: 400; color: var(--color-muted); font-size: var(--text-sm); }
  .role { color: var(--color-primary); font-weight: 600; margin-bottom: var(--space-2); }
  summary { cursor: pointer; font-weight: 600; color: var(--color-primary); }
  details .prose { margin-top: var(--space-3); font-size: var(--text-sm); }
</style>
