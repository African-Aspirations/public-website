---
/**
 * Markdown text with an optional image beside it.
 * variant "diagonal": image centred on white, text on a dark-green panel whose
 * slanted edge runs to the right edge of the screen (used for partners).
 * imageSide "below": text centred, the image centred underneath (diagrams). The image
 * keeps a 40rem minimum width and scrolls sideways on phones so labels stay legible.
 */
import type { SectionData } from "@aa/db";
import { marked } from "marked";
import { getContent } from "../../lib/content";
import Img from "../Img.astro";
import Section from "../ui/Section.astro";
import SectionHeader from "../ui/SectionHeader.astro";

interface Props {
  data: SectionData<"rich_text">;
}
const { data } = Astro.props;
const c = await getContent();
const image = c.media(data.imageId);
const html = await marked.parse(data.body);
const diagonal = data.variant === "diagonal";
---
{diagonal ? (
  <Section id={data.anchor} class="relative overflow-hidden pb-0 md:pb-section">
    <div class="absolute inset-y-0 right-0 hidden w-[56%] bg-brand-dark [clip-path:polygon(16%_0,100%_0,100%_100%,0_100%)] md:block" aria-hidden="true"></div>
    <div class="relative grid items-center md:grid-cols-2 md:gap-gutter">
      {image && <Img media={image} sizes="(min-width: 48rem) 320px, 80vw" class="mb-12 w-full max-w-80 justify-self-center md:mb-0" />}
      <div class="-mx-gutter bg-brand-dark px-gutter py-12 text-white md:mx-0 md:bg-transparent md:py-8 md:pl-16">
        {data.heading && <h2 class="text-lg text-white md:text-xl">{data.heading}</h2>}
        <div class="prose mt-4 text-lg leading-relaxed text-white-70" set:html={html} />
      </div>
    </div>
  </Section>
) : data.imageSide === "below" ? (
  <Section id={data.anchor}>
    <SectionHeader eyebrow={data.eyebrow} heading={data.heading} align="center" />
    <div class="prose mx-auto -mt-4 max-w-narrow text-center text-muted-foreground" set:html={html} />
    {image && (
      <div class="-mx-gutter mt-12 overflow-x-auto px-gutter">
        <Img media={image} sizes="(min-width: 64rem) 760px, 640px" class="mx-auto w-full min-w-[40rem] max-w-3xl" />
      </div>
    )}
  </Section>
) : (
  <Section id={data.anchor}>
    <div class:list={["grid items-center gap-gutter", image && "md:grid-cols-2"]}>
      <div class:list={["max-w-narrow", image && data.imageSide === "left" && "md:order-2"]}>
        <SectionHeader eyebrow={data.eyebrow} heading={data.heading} />
        <div class="prose" set:html={html} />
      </div>
      {image && <Img media={image} sizes="(min-width: 64rem) 520px, 100vw" class="w-full rounded-media" />}
    </div>
  </Section>
)}
