---
import type { SectionData } from "@aa/db";
import { marked } from "marked";
import { getContent } from "../../lib/content";
import Img from "../Img.astro";

interface Props {
  data: SectionData<"rich_text">;
}
const { data } = Astro.props;
const c = await getContent();
const image = c.media(data.imageId);
const html = await marked.parse(data.body);
---
<section class="layout section">
  <div class:list={["grid-12", { "img-left": data.imageSide === "left" }]}>
    <div class="text" style={image ? undefined : "grid-column: 1 / span 8"}>
      {data.eyebrow && <p class="eyebrow">{data.eyebrow}</p>}
      {data.heading && <h2>{data.heading}</h2>}
      <div class="prose" set:html={html} />
    </div>
    {image && <div class="media"><Img media={image} sizes="(min-width: 64rem) 520px, 100vw" /></div>}
  </div>
</section>
<style>
  .text { grid-column: 1 / span 6; align-self: center; }
  .media { grid-column: 8 / -1; }
  .img-left .text { grid-column: 7 / -1; grid-row: 1; }
  .img-left .media { grid-column: 1 / span 5; grid-row: 1; }
  .media :global(img) { border-radius: var(--radius); width: 100%; }
</style>
