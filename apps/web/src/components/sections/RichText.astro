---
import type { SectionData } from "@aa/db";
import { marked } from "marked";
import { getContent } from "../../lib/content";
import Img from "../Img.astro";
import Section from "../ui/Section.astro";
import SectionHeader from "../ui/SectionHeader.astro";

interface Props {
  data: SectionData<"rich_text">;
}
const { data } = Astro.props;
const c = await getContent();
const image = c.media(data.imageId);
const html = await marked.parse(data.body);
---
<Section>
  <div class:list={["grid items-center gap-gutter", image && "md:grid-cols-2"]}>
    <div class:list={["max-w-narrow", image && data.imageSide === "left" && "md:order-2"]}>
      <SectionHeader eyebrow={data.eyebrow} heading={data.heading} />
      <div class="prose" set:html={html} />
    </div>
    {image && <Img media={image} sizes="(min-width: 64rem) 520px, 100vw" class="w-full rounded-xl" />}
  </div>
</Section>
