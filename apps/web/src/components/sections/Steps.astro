---
import type { SectionData } from "@aa/db";
import Section from "../ui/Section.astro";
import SectionHeader from "../ui/SectionHeader.astro";

interface Props {
  data: SectionData<"steps">;
}
const { data } = Astro.props;
---
<Section>
  <SectionHeader eyebrow={data.eyebrow} heading={data.heading} intro={data.intro} />
  <ol class="grid gap-gutter sm:grid-cols-2 lg:grid-cols-[repeat(auto-fit,minmax(16rem,1fr))]">
    {data.steps.map((s, i) => (
      <li class="border-t-2 border-primary pt-4">
        <span class="mb-2 block font-semibold text-brand-leaf">{String(i + 1).padStart(2, "0")}</span>
        <h3 class="text-lg">{s.title}</h3>
        {s.body && <p class="mt-2 text-muted-foreground">{s.body}</p>}
      </li>
    ))}
  </ol>
</Section>
