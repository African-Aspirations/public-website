---
import type { SectionData } from "@aa/db";
import { getContent } from "../../lib/content";
import ListingCard from "../ListingCard.astro";
import Section from "../ui/Section.astro";

interface Props {
  data: SectionData<"listings_teaser">;
}
const { data } = Astro.props;
const c = await getContent();
const featured = [...c.listings]
  .sort((a, b) => Number(b.featured) - Number(a.featured))
  .slice(0, data.limit);
---
{featured.length > 0 && (
  <Section>
    <div class="mb-6 flex flex-wrap items-baseline justify-between gap-4">
      <h2 class="text-title">{data.heading ?? "Businesses for sale"}</h2>
      <a href="/listings" class="font-medium text-primary">View all listings →</a>
    </div>
    <ul class="grid gap-gutter sm:grid-cols-2 lg:grid-cols-3">{featured.map((l) => <li><ListingCard listing={l} /></li>)}</ul>
  </Section>
)}
