---
/**
 * Call-to-action.
 * - "band" tone: light band; an image sits beside the text (left/right, optionally mirrored).
 * - "dark" tone: with an image, the photo fills the full width behind the text under a
 *   dark overlay; without one, a solid green band.
 */
import type { SectionData } from "@aa/db";
import { getContent } from "../../lib/content";
import Img from "../Img.astro";
import Button from "../ui/Button.astro";
import Section from "../ui/Section.astro";

interface Props {
  data: SectionData<"cta">;
}
const { data } = Astro.props;
const c = await getContent();
const image = c.media(data.imageId);
const dark = data.tone === "dark";
---
{dark ? (
  <Section tone="dark" class="relative isolate overflow-hidden">
    {image && (
      <>
        <Img media={image} sizes="100vw" aspect={3} alt="" class="absolute inset-0 -z-10 h-full w-full object-cover" />
        <div class="absolute inset-0 -z-10 bg-black-60" aria-hidden="true"></div>
      </>
    )}
    <div class="max-w-2xl">
      <h2 class="text-title text-white">{data.heading}</h2>
      {data.body && <p class="mt-3 text-lg text-white-85">{data.body}</p>}
      <Button href={data.cta.href} variant="gold" size="lg" class="mt-8 h-12 gap-6 pl-7 pr-3">
        {data.cta.label}
        <svg class="size-7" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="10" /><path d="M8 12h8m-4-4 4 4-4 4" /></svg>
      </Button>
    </div>
  </Section>
) : (
  <Section tone={data.tone}>
    <div class:list={["grid items-center gap-10", image && "md:grid-cols-2 md:gap-gutter"]}>
      <div class:list={[!image && "max-w-narrow", image && data.imageSide === "left" && "md:order-2"]}>
        <h2 class:list={[image ? "text-2xl md:text-3xl" : "text-2xl"]}>{data.heading}</h2>
        {data.body && <p class="mt-3 opacity-90">{data.body}</p>}
        <Button href={data.cta.href} class:list={[image ? "mt-8" : "mt-6"]} size={image ? "default" : "lg"}>{data.cta.label}</Button>
      </div>
      {image && <Img media={image} sizes="(min-width: 64rem) 620px, 100vw" class:list={["w-full mix-blend-multiply", data.imageMirror && "-scale-x-100"]} />}
    </div>
  </Section>
)}
