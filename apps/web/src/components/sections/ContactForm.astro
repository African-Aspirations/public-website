---
import type { SectionData } from "@aa/db";
import Turnstile from "../Turnstile.astro";
import Alert from "../ui/Alert.astro";
import Button from "../ui/Button.astro";
import Field from "../ui/Field.astro";
import Input from "../ui/Input.astro";
import Section from "../ui/Section.astro";
import SectionHeader from "../ui/SectionHeader.astro";
import Textarea from "../ui/Textarea.astro";

interface Props {
  data: SectionData<"contact_form">;
}
const { data } = Astro.props;
---
<Section>
  <div class="max-w-narrow">
    <SectionHeader heading={data.heading} intro={data.intro} />
    <Alert id="sent" variant="success" class="mb-6">Thank you — your message has been sent. We'll be in touch shortly.</Alert>
    <Alert id="error" variant="destructive" class="mb-6">Something went wrong. Please try again, or email us directly.</Alert>
    <form method="post" action="/api/contact" class="grid gap-5">
      <div class="grid gap-5 sm:grid-cols-2">
        <Field label="Full name"><Input name="name" required autocomplete="name" maxlength={120} /></Field>
        <Field label="Email"><Input name="email" type="email" required autocomplete="email" maxlength={200} /></Field>
        <Field label="Phone" hint="(optional)"><Input name="phone" type="tel" autocomplete="tel" maxlength={40} /></Field>
        <Field label="Company" hint="(optional)"><Input name="company" autocomplete="organization" maxlength={160} /></Field>
      </div>
      <Field label="How can we help?"><Textarea name="message" rows={6} required maxlength={5000} /></Field>
      <input class="absolute -left-[9999px]" name="website" tabindex="-1" autocomplete="off" aria-hidden="true" />
      <Turnstile />
      <Button type="submit" size="lg" class="justify-self-start">Send message</Button>
    </form>
  </div>
</Section>
