---
import type { SectionData } from "@aa/db";
import { getContent } from "../../lib/content";
import Accordion from "../ui/Accordion.astro";
import Section from "../ui/Section.astro";

interface Props {
  data: SectionData<"faq">;
}
const { data } = Astro.props;
const c = await getContent();
const faqs = c.faqs.filter((f) => !data.topic || f.topic === data.topic);
const jsonLd = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  mainEntity: faqs.map((f) => ({
    "@type": "Question",
    name: f.question,
    acceptedAnswer: { "@type": "Answer", text: f.answer },
  })),
};
---
{faqs.length > 0 && (
  <Section>
    <div class="max-w-narrow">
      <h2 class="mb-4 text-title">{data.heading ?? "Frequently asked questions"}</h2>
      {faqs.map((f) => <Accordion title={f.question} name="faq"><p>{f.answer}</p></Accordion>)}
    </div>
    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
  </Section>
)}
