---
import { getContent } from "../lib/content";
import Img from "./Img.astro";
import Button from "./ui/Button.astro";

const c = await getContent();
const { settings, header } = c;
const logo = c.media(settings.logoId);
const path = Astro.url.pathname.replace(/\/$/, "") || "/";
const isCurrent = (href: string) => href === path || (href !== "/" && path.startsWith(`${href}/`));
const link =
  "font-medium text-foreground no-underline hover:text-primary aria-[current=page]:text-primary aria-[current=page]:underline";
---
<header class="site-header layout sticky top-0 z-40 border-b bg-background">
  <div class="relative flex min-h-18 items-center gap-6">
    <a href="/" class="logo w-30 shrink-0" aria-label={`${settings.orgName} home`}>
      <Img media={logo} sizes="120px" priority alt={settings.orgName} />
    </a>
    <button class="menu-toggle ml-auto rounded-md border px-4 py-2 font-semibold lg:hidden" type="button" aria-expanded="false" aria-controls="site-nav">Menu</button>
    <nav
      id="site-nav"
      class="absolute inset-x-[calc(-1*var(--gutter))] top-full hidden max-h-[calc(100dvh-4.5rem)] flex-col gap-4 overflow-y-auto border-b bg-background px-gutter pb-8 pt-4 in-[.nav-open]:flex lg:static lg:ml-auto lg:flex lg:max-h-none lg:flex-row lg:items-center lg:gap-6 lg:overflow-visible lg:border-0 lg:bg-transparent lg:p-0"
      aria-label="Main"
    >
      <ul class="flex flex-col gap-4 lg:flex-row lg:items-center lg:gap-6">
        {header.map((item) =>
          item.children.length ? (
            <li>
              <details name="nav" class="group relative">
                <summary class={`${link} cursor-pointer list-none [&::-webkit-details-marker]:hidden`}>
                  {item.label}<span class="ml-1 inline-block text-xs group-open:rotate-180" aria-hidden="true">▾</span>
                </summary>
                <ul class="mt-2 grid gap-1 lg:absolute lg:-left-4 lg:top-full lg:mt-3 lg:w-80 lg:rounded-lg lg:border lg:bg-popover lg:p-2 lg:shadow-popover">
                  {item.children.map((child) => (
                    <li>
                      <a href={child.href} aria-current={isCurrent(child.href) ? "page" : undefined} class="block rounded-md px-3 py-2 no-underline hover:bg-accent">
                        <span class="block font-medium text-foreground">{child.label}</span>
                        {child.description && <span class="block text-sm text-muted-foreground">{child.description}</span>}
                      </a>
                    </li>
                  ))}
                </ul>
              </details>
            </li>
          ) : (
            <li><a href={item.href} class={link} aria-current={isCurrent(item.href) ? "page" : undefined}>{item.label}</a></li>
          ),
        )}
      </ul>
      {settings.ctaUrl && settings.ctaLabel && <Button href={settings.ctaUrl} variant="gold" class="self-start lg:self-auto">{settings.ctaLabel}</Button>}
    </nav>
  </div>
</header>
<noscript><style>#site-nav{display:flex}.menu-toggle{display:none}</style></noscript>
<script is:inline>
  {
    const b = document.querySelector(".menu-toggle");
    b.addEventListener("click", () => {
      const open = b.getAttribute("aria-expanded") !== "true";
      b.setAttribute("aria-expanded", open);
      document.body.classList.toggle("nav-open", open);
    });
    document.addEventListener("click", (e) => {
      for (const d of document.querySelectorAll("#site-nav details[open]")) if (!d.contains(e.target)) d.open = false;
    });
  }
</script>
