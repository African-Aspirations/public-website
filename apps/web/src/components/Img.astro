---
/**
 * The only way images are rendered. Always has width/height (no layout shift),
 * responsive srcset from Cloudinary, lazy by default; `priority` for the LCP image.
 * Without a Cloudinary cloud name (local dev before setup) it renders a tinted
 * box of the right aspect ratio instead of a broken image.
 */
import { cloudinaryEnabled, responsive } from "../lib/cloudinary";
import type { Media } from "../lib/content";

interface Props {
  media: Media | null;
  sizes: string;
  /** Crop to this aspect ratio (width / height); otherwise keep the original. */
  aspect?: number;
  priority?: boolean;
  class?: string;
  alt?: string;
}
const { media, sizes, aspect, priority = false, class: cls, alt } = Astro.props;
const r = media && cloudinaryEnabled ? responsive(media, aspect) : null;
const ratio = aspect ?? (media ? media.width / media.height : 16 / 9);
---
{media && r ? (
  <img
    src={r.src}
    srcset={r.srcset}
    sizes={sizes}
    width={r.width}
    height={r.height}
    alt={alt ?? media.alt}
    loading={priority ? "eager" : "lazy"}
    decoding={priority ? "sync" : "async"}
    fetchpriority={priority ? "high" : undefined}
    class={cls}
  />
) : (
  <div class:list={["img-placeholder", cls]} style={`aspect-ratio:${ratio}`} role={media?.alt ? "img" : undefined} aria-label={media?.alt || undefined}></div>
)}
<style>
  .img-placeholder { background: var(--color-band); width: 100%; }
</style>
