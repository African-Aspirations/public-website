---
import { getContent } from "../lib/content";
import ListingCard from "./ListingCard.astro";

const c = await getContent();
const { listings, categories } = c;
const usedCats = categories.filter((cat) => listings.some((l) => l.categoryId === cat.id));
---
<section class="layout section browser">
  <div>
    {listings.length === 0 ? (
      <div class="empty">
        <h2>No businesses are listed right now</h2>
        <p>New opportunities are added regularly. <a href="/contact">Tell us what you're looking for</a> and we'll reach out when something fits.</p>
      </div>
    ) : (
      <>
        <form class="filters" role="search" aria-label="Filter listings">
          <label>Search<input type="search" name="q" placeholder="Name, sector or region" /></label>
          {usedCats.length > 0 && (
            <label>Sector
              <select name="cat"><option value="">All sectors</option>{usedCats.map((cat) => <option value={cat.slug}>{cat.label}</option>)}</select>
            </label>
          )}
          <label>Min price<input type="number" name="min" min="0" step="1000" inputmode="numeric" /></label>
          <label>Max price<input type="number" name="max" min="0" step="1000" inputmode="numeric" /></label>
          <label>Sort
            <select name="sort">
              <option value="new">Newest</option>
              <option value="price-asc">Price: low to high</option>
              <option value="price-desc">Price: high to low</option>
            </select>
          </label>
        </form>
        <p class="count" aria-live="polite"><span data-count>{listings.length}</span> of {listings.length} listings</p>
        <ul class="grid" data-listings>
          {listings.map((l, i) => (
            <li
              data-text={[l.name, l.summary, l.location, l.region, l.category?.label].filter(Boolean).join(" ").toLowerCase()}
              data-cat={l.category?.slug ?? ""}
              data-price={l.price ?? ""}
              data-order={i}
            >
              <ListingCard listing={l} />
            </li>
          ))}
        </ul>
        <p class="none" hidden>No listings match these filters.</p>
      </>
    )}
  </div>
</section>
<script is:inline>
  {
    const f = document.querySelector(".filters");
    if (f) {
      const list = document.querySelector("[data-listings]");
      const items = [...list.children];
      const count = document.querySelector("[data-count]");
      const none = document.querySelector(".none");
      const p = new URLSearchParams(location.search);
      for (const el of f.elements) if (el.name && p.has(el.name)) el.value = p.get(el.name);
      const run = () => {
        const q = f.q.value.trim().toLowerCase();
        const cat = f.cat ? f.cat.value : "";
        const min = Number(f.min.value) || 0;
        const max = Number(f.max.value) || Infinity;
        const sort = f.sort.value;
        let shown = 0;
        for (const li of items) {
          const price = li.dataset.price === "" ? null : Number(li.dataset.price);
          const ok =
            (!q || li.dataset.text.includes(q)) &&
            (!cat || li.dataset.cat === cat) &&
            (price === null ? !f.min.value && !f.max.value : price >= min && price <= max);
          li.hidden = !ok;
          if (ok) shown++;
        }
        const num = (li, d) => (li.dataset.price === "" ? d : Number(li.dataset.price));
        const sorted = [...items].sort((a, b) =>
          sort === "price-asc" ? num(a, Infinity) - num(b, Infinity)
          : sort === "price-desc" ? num(b, -1) - num(a, -1)
          : a.dataset.order - b.dataset.order);
        list.append(...sorted);
        count.textContent = shown;
        none.hidden = shown > 0;
        const out = new URLSearchParams();
        for (const el of f.elements) if (el.name && el.value && !(el.name === "sort" && el.value === "new")) out.set(el.name, el.value);
        history.replaceState(null, "", out.size ? `?${out}` : location.pathname);
      };
      f.addEventListener("input", run);
      f.addEventListener("submit", (e) => { e.preventDefault(); run(); });
      run();
    }
  }
</script>
<style>
  .browser { padding-top: 0; }
  .filters { display: grid; gap: var(--space-4); grid-template-columns: repeat(auto-fit, minmax(min(100%, 10rem), 1fr)); margin-bottom: var(--space-4); }
  .filters label { display: grid; gap: var(--space-1); font-size: var(--text-sm); font-weight: 600; }
  input, select { font: inherit; font-weight: 400; padding: 0.6rem 0.75rem; border: 1px solid #c9cfc4; border-radius: var(--radius); background: #fff; width: 100%; }
  .count { color: var(--color-muted); font-size: var(--text-sm); }
  .grid { list-style: none; margin: 0; padding: 0; display: grid; gap: var(--space-8) var(--gutter); grid-template-columns: repeat(auto-fill, minmax(min(100%, 16rem), 1fr)); }
  .grid [hidden], .none[hidden] { display: none; }
  .empty { max-width: var(--content-narrow); }
</style>
