---
/** Success/error messages shown via CSS :target after the endpoint redirects to #sent / #error. */
interface Props {
  sent: string;
  error?: string;
}
const { sent, error = "Something went wrong. Please try again, or email us directly." } =
  Astro.props;
---
<p id="sent" class="status ok" role="status">{sent}</p>
<p id="error" class="status err" role="alert">{error}</p>
<style>
  .status { display: none; padding: var(--space-3) var(--space-4); border-radius: var(--radius); }
  .status:target { display: block; }
  .ok { background: var(--color-band); color: var(--green-900); }
  .err { background: #fdecea; color: #8a1c13; }
</style>
