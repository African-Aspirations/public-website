---
/**
 * Cloudflare Turnstile spam check. Renders nothing until PUBLIC_TURNSTILE_SITE_KEY
 * is set. The script loads async and only on pages that contain a form.
 */
const siteKey = import.meta.env.PUBLIC_TURNSTILE_SITE_KEY as string | undefined;
---
{siteKey && (
  <>
    <div class="cf-turnstile" data-sitekey={siteKey} data-size="flexible" data-appearance="interaction-only"></div>
    <script is:inline src="https://challenges.cloudflare.com/turnstile/v0/api.js" async defer></script>
  </>
)}
