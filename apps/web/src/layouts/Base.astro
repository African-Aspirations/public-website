---
import "../styles/global.css";
import Footer from "../components/Footer.astro";
import Header from "../components/Header.astro";
import { cldUrl, cloudinaryEnabled } from "../lib/cloudinary";
import { getContent, type Media } from "../lib/content";

interface Props {
  title?: string | null;
  description?: string | null;
  noindex?: boolean;
  ogImage?: Media | null;
  jsonLd?: Record<string, unknown>[];
  /** LCP image to preload (the first hero image). */
  preload?: { srcset: string; sizes: string } | null;
}
const c = await getContent();
const { settings } = c;
const { title, description, noindex = false, ogImage, jsonLd = [], preload } = Astro.props;

const fullTitle = title ? `${title} | ${settings.orgName}` : settings.defaultSeoTitle;
const desc = description || settings.defaultSeoDescription;
const canonical = new URL(Astro.url.pathname.replace(/\/$/, "") || "/", Astro.site).toString();
const og = ogImage ?? c.media(settings.defaultOgImageId);
const ogUrl =
  og && cloudinaryEnabled
    ? cldUrl(og.publicId, { width: 1200, height: 630, rasterize: og.format === "svg" })
    : null;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={desc} />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex" />}
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={settings.orgName} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={desc} />
    <meta property="og:url" content={canonical} />
    {ogUrl && <meta property="og:image" content={ogUrl} />}
    {ogUrl && <meta property="og:image:width" content="1200" />}
    {ogUrl && <meta property="og:image:height" content="630" />}
    <meta name="twitter:card" content={ogUrl ? "summary_large_image" : "summary"} />
    <meta name="theme-color" content="#015a1a" />
    <link rel="icon" href="/favicon.ico" sizes="32x32" />
    <link rel="icon" href="/icon-192.png" type="image/png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    {preload && <link rel="preload" as="image" imagesrcset={preload.srcset} imagesizes={preload.sizes} fetchpriority="high" />}
    {cloudinaryEnabled && <link rel="preconnect" href="https://res.cloudinary.com" />}
    {jsonLd.map((data) => <script type="application/ld+json" set:html={JSON.stringify(data)} />)}
  </head>
  <body>
    <a class="sr-only focus:not-sr-only focus:absolute focus:left-4 focus:top-4 focus:z-50 focus:rounded-md focus:bg-background focus:px-4 focus:py-2" href="#main">Skip to content</a>
    <Header />
    <main id="main">
      <slot />
    </main>
    <Footer />
  </body>
</html>
