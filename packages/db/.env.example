# packages/db/.env — used ONLY on your machine / CI for migrations, seeding and the image upload.
# Never deploy this file. Copy to packages/db/.env and fill in.

# Supabase → Connect → "Session pooler" string (port 5432), postgres user. Owner rights: runs migrations + seed.
DATABASE_MIGRATION_URL=postgresql://postgres.<project-ref>:<db-password>@aws-0-<region>.pooler.supabase.com:5432/postgres

# Cloudinary → Settings → API Keys. Needed for `bun run assets:migrate`.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
